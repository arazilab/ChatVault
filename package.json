{
  "name": "chatvault",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Chrome extension for backing up and exporting AI chatbot conversations",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "dev": "wxt",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.3",
    "wxt": "^0.19.20"
  }
}
